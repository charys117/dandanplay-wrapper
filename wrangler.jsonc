{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dandanplay-wrapper",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "CACHE_TTL_SECONDS": "86400"
  },
  "secrets": {
    "required": [
      "DANDANPLAY_APP_ID",
      "DANDANPLAY_APP_SECRET",
      "PROXY_TOKEN"
    ]
  }
}
